# Skills Registry settings. Copy to .env and fill in: cp .env.example .env
# Optional lines are commented out; an empty value (KEY=) counts as unset.

# ---------- Network ----------

# Host port the server is exposed on (inside the container it is always 3000).
PORT=3000

# The address users and Claude Code use to open the server (scheme + host + port).
# The connect command (`claude mcp add … <PUBLIC_URL>/mcp`) is built from it, and the
# Origin header is checked against it. Behind a proxy, set the external address, e.g. https://skills.example.com
PUBLIC_URL=http://localhost:3000

# Additional allowed values of the Host header for /mcp, comma-separated (no port).
# The host from PUBLIC_URL, localhost and 127.0.0.1 are allowed automatically.
# ALLOWED_HOSTS=skills.internal,skills

# true — the server runs behind a reverse proxy (nginx, Traefik, Caddy), and the client IP is taken
# from X-Forwarded-For. Without a proxy, keep false, otherwise a client can spoof its IP.
TRUST_PROXY=false

# How many trusted proxies sit in front of the server (1–5). The client IP is the entry at this
# position from the right in X-Forwarded-For. Used only when TRUST_PROXY=true.
TRUST_PROXY_HOPS=1

# Secure flag on the session cookie. Keep true: this works with HTTPS (via a proxy) and http://localhost.
# false — only if the web UI is opened over plain HTTP from a host other than localhost (e.g.
# http://192.168.1.10:3000); otherwise the browser will not store the cookie and sign-in will fail.
COOKIE_SECURE=true

# ---------- Secrets ----------

# Reserved, currently unused (sessions are random ids; the database stores their hash).
# If you set it, it must be at least 32 characters: openssl rand -base64 32
# SESSION_SECRET=

# Postgres database password. Generate one: openssl rand -base64 32
# Set it before the first start: after that it is already stored in the pgdata volume.
POSTGRES_PASSWORD=

# Postgres connection string. By default docker-compose.yml connects the server
# to its own db container (postgres://skills@db:5432/skills, password — POSTGRES_PASSWORD).
# Uncomment only for an external database. POSTGRES_PASSWORD must still be set
# (to any value): without it docker compose will not start.
# DATABASE_URL=postgres://user:password@host:5432/skills

# ---------- First administrator ----------

# If the database has no users yet, an administrator with this login and password is
# created at startup (password at least 12 characters). These lines can be removed afterwards.
# Without ADMIN_PASSWORD no administrator is created (you can add one with the CLI command create-user).
ADMIN_LOGIN=admin
# ADMIN_PASSWORD=

# ---------- Search (embeddings) ----------

# local — the built-in multilingual-e5-small model, works offline (default).
# openai-compatible — an external service with the API POST <EMBEDDER_URL>/embeddings (requires EMBEDDER_URL and EMBEDDER_MODEL).
EMBEDDER=local

# URL and model of the external embedding service, only for EMBEDDER=openai-compatible.
# The model must produce 384-dimensional vectors.
# EMBEDDER_URL=http://embeddings.internal:8080/v1
# EMBEDDER_MODEL=multilingual-e5-small

# Cosine similarity threshold (0..1) for semantic search: a skill below the threshold that has
# no word matches is left out of the results. Default 0.80, tuned for
# multilingual-e5-small (docs/adr/0005-search-relevance-floor.md). Re-tune it for a different model.
# SEARCH_MIN_SIMILARITY=0.80

# Directory with the local model. In the image the model is already in /app/models — don't change without need.
MODEL_DIR=/app/models

# ---------- Logs ----------

# Log level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
